{
  "name": "granboard",
  "version": "0.2.0",
  "description": "TypeScript client for GranBoard electronic dartboards over Bluetooth LE: decode dart hits and control the LED ring.",
  "keywords": [
    "granboard",
    "dartboard",
    "darts",
    "bluetooth",
    "ble",
    "web-bluetooth"
  ],
  "license": "MIT",
  "author": "keenanlk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenanlk/granboard-ble-codes.git",
    "directory": "packages/granboard"
  },
  "bugs": {
    "url": "https://github.com/keenanlk/granboard-ble-codes/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "homepage": "https://keenanlk.github.io/granboard-ble-codes/api/"
}
